# 复制为 .env.local（可选，也可在页面「设置」里填）

# --- 云端 DeepSeek ---
# VITE_OPENAI_BASE_URL=https://api.deepseek.com
# VITE_OPENAI_API_KEY=sk-...
# VITE_OPENAI_MODEL=deepseek-chat

# --- 本机 Ollama（OpenAI 兼容）---
# VITE_OPENAI_BASE_URL=http://127.0.0.1:11434
# VITE_OPENAI_API_KEY=
# VITE_OPENAI_MODEL=llama3.2

# --- 可选 mem0 Platform（跨会话记忆；默认关闭，也可在 API Settings 里填）---
# VITE_MEM0_API_KEY=m0-...
# VITE_MEM0_HOST=https://api.mem0.ai
