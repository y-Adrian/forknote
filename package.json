{
  "name": "forknote",
  "private": true,
  "version": "0.1.0",
  "description": "ForkNote — clarify as you read",
  "author": "ForkNote",
  "type": "module",
  "main": "electron/main.cjs",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "test:agent": "node scripts/test-agent-suite.mjs",
    "dev": "node scripts/dev.mjs",
    "dev:web": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "sidecar": "node sidecar/index.js",
    "test:electron-openai-proxy": "node scripts/test-electron-openai-proxy.cjs",
    "test:stream-storage-throttle": "tsx scripts/test-stream-storage-throttle.mts",
    "test:vite-chunking": "node scripts/test-vite-chunking.mjs",
    "electron:dev": "ELECTRON_DEV=1 electron .",
    "electron:build:mac": "npm run build && CSC_IDENTITY_AUTO_DISCOVERY=false electron-builder --mac --dir",
    "electron:release:mac": "npm run build && CSC_IDENTITY_AUTO_DISCOVERY=false electron-builder --mac dmg zip",
    "electron:build:win": "npm run build && CSC_IDENTITY_AUTO_DISCOVERY=false electron-builder --win --dir",
    "electron:release:win": "npm run build && CSC_IDENTITY_AUTO_DISCOVERY=false electron-builder --win nsis zip",
    "electron:build:linux": "npm run build && CSC_IDENTITY_AUTO_DISCOVERY=false electron-builder --linux --dir",
    "electron:release:linux": "npm run build && CSC_IDENTITY_AUTO_DISCOVERY=false electron-builder --linux AppImage deb",
    "test:desktop-build-pipelines": "node scripts/test-desktop-build-pipelines.mjs"
  },
  "dependencies": {
    "docx": "^9.7.1",
    "exceljs": "^4.4.0",
    "mermaid": "^11.16.1",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-markdown": "^10.1.0",
    "remark-breaks": "^4.0.0",
    "remark-gfm": "^4.0.1",
    "zustand": "^5.0.5"
  },
  "devDependencies": {
    "@fontsource/dela-gothic-one": "^5.3.0",
    "@fontsource/ibm-plex-sans": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@types/react": "^19.1.2",
    "@types/react-dom": "^19.1.2",
    "@vitejs/plugin-react": "^4.4.1",
    "electron": "^37.10.3",
    "electron-builder": "^24.13.3",
    "tsx": "^4.19.4",
    "typescript": "~5.8.3",
    "vite": "^6.3.5"
  },
  "build": {
    "appId": "app.forknote.desktop",
    "productName": "ForkNote",
    "copyright": "Copyright © ForkNote",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "sidecar/**/*",
      "shared/**/*",
      "package.json",
      "node_modules/docx/**/*",
      "node_modules/exceljs/**/*"
    ],
    "asar": false,
    "extraMetadata": {
      "main": "electron/main.cjs"
    },
    "afterSign": "scripts/macos-notarize.cjs",
    "mac": {
      "category": "public.app-category.productivity",
      "icon": "build/icon.icns",
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.plist",
      "target": [
        "dir"
      ]
    },
    "dmg": {
      "title": "${productName} ${version}"
    },
    "win": {
      "icon": "build/icon.png",
      "target": [
        "dir"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "linux": {
      "icon": "build/icon.png",
      "category": "Office",
      "target": [
        "dir"
      ]
    }
  }
}
